{
  "name": "fleetforge",
  "version": "1.0.0",
  "private": true,
  "description": "FleetForge — Autonomous Fleet Coordination Dashboard",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@fleetforge/frontend",
    "build": "npm run build --workspace=@fleetforge/frontend",
    "preview": "npm run preview --workspace=@fleetforge/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}