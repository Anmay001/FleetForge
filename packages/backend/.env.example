# FleetForge Backend Configuration
# Copy this file to .env and adjust values as needed.

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Database — SQLite for local dev, PostgreSQL URL for prod
DATABASE_URL=./data/fleetforge.db

# Snapshot interval (ms) — how often to persist robot state
SNAPSHOT_INTERVAL_MS=10000

# Event log retention — how many events to keep in memory
EVENT_LOG_LIMIT=500