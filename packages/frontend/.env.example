# FleetForge Frontend Configuration
# Copy to .env.local to enable server sync.

# Leave unset (or comment out) to run in local-only mode.
# Set to the backend URL to enable server sync (WebSocket + REST).
#
# Local dev:
# VITE_BACKEND_URL=http://localhost:4000
#
# Production:
# VITE_BACKEND_URL=https://fleetforge-api.up.railway.app

# Optional: interval (ms) at which the frontend pushes fleet
# snapshots to the backend in server mode. Default 5000.
# VITE_FLEET_PUSH_INTERVAL_MS=5000